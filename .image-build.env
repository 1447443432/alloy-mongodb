# Local image build configuration.
#
# Precedence, from highest to lowest:
#   1. workflow_dispatch inputs
#   2. GitHub Repository Variables
#   3. values in this file
#   4. workflow defaults
#
# Keep credentials out of this file. Put registry credentials and HAP secrets
# in GitHub Actions Secrets instead.

# Explicit Release tag. Image references below carry their own explicit Tags.
IMAGE_TAG=1.0.0
ARCHITECTURES=all
# Git push mode: auto, build-release, pull-release or build-push-release.
PUSH_OPERATION=auto
RELEASE_NAME=hap-alloy-vlogs-mongodb

# Architecture-specific Alloy base images. The official image is multi-arch.
BASE_IMAGE_AMD64=grafana/alloy:v1.21.2
BASE_IMAGE_ARM64=grafana/alloy:v1.21.2

# These are local build image references. Their contents are used as-is.
TARGET_IMAGE_AMD64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-alloy-vlogs-mongodb-amd64:1.0.0
TARGET_IMAGE_ARM64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-alloy-vlogs-mongodb-arm64:1.0.0

# Optional Aliyun registry settings.
ALIYUN_REGISTRY=registry.cn-hangzhou.aliyuncs.com

# Optional explicit Aliyun destinations. Their contents are used as-is.
ALIYUN_IMAGE_AMD64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-alloy-vlogs-mongodb-amd64:1.0.0
ALIYUN_IMAGE_ARM64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-alloy-vlogs-mongodb-arm64:1.0.0

# Module switches. On Git push, a complete Aliyun configuration plus this
# switch enables automatic build-push-release; otherwise the workflow falls
# back to build-release. Manual build-push-release, or an explicitly selected
# push mode, still requires complete destination/credential configuration.
# Any skipped module writes the reason to the Actions job summary.
ENABLE_ALIYUN_PUSH=true
ENABLE_RELEASE=true
ENABLE_HAP_WEBHOOK=true

# Docker build settings.
DOCKERFILE=Dockerfile
BUILD_CONTEXT=.

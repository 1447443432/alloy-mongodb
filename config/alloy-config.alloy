logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "mongodb" {
  path_targets = [
    {
      __path__ = sys.env("MONGODB_LOG_PATH"),
      job      = sys.env("MONGODB_JOB_NAME"),
      host     = sys.env("MONGODB_HOSTNAME"),
      instance = sys.env("MONGODB_HOSTNAME"),
    },
  ]
}

loki.source.file "mongodb" {
  targets    = local.file_match.mongodb.targets
  forward_to = [loki.process.mongodb.receiver]
}

loki.process "mongodb" {
  // Parse MongoDB JSON logs and use the embedded timestamp.
  stage.json {
    expressions = {
      ts             = "t.\"$date\"",
      severity       = "s",
      c              = "c",
      msg            = "msg",
      attr           = "attr",
      durationMillis = "attr.durationMillis",
      ns             = "attr.ns",
      planSummary    = "attr.planSummary",
      docsExamined   = "attr.docsExamined",
      reslen         = "attr.reslen",
    }
    drop_malformed = true
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339"
  }

  // Keep only MongoDB slow-query records.
  stage.labels {
    values = {
      c   = "",
      msg = "",
    }
  }

  stage.match {
    selector            = "{c!=\"COMMAND\"}"
    action              = "drop"
    drop_counter_reason = "not_command"
  }

  stage.match {
    selector            = "{msg!=\"Slow query\"}"
    action              = "drop"
    drop_counter_reason = "not_slow_query"
  }

  stage.label_drop {
    values = [
      "c",
      "msg",
    ]
  }

  stage.template {
    source = "level"

    template = `{{ if eq .severity "I" }}info{{ else if eq .severity "W" }}warn{{ else if eq .severity "E" }}error{{ else if eq .severity "F" }}critical{{ else if eq .severity "D" }}debug{{ else }}info{{ end }}`
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.structured_metadata {
    values = {
      durationMillis = "",
      ns             = "",
      planSummary    = "",
      docsExamined   = "",
      reslen         = "",
    }
  }

  stage.template {
    source = "display_msg"

    template = `{
  "ns": {{ toJson .ns }},
  "durationMillis": {{ toJson (printf "%v" .durationMillis) }},
  "planSummary": {{ toJson .planSummary }},
  "docsExamined": {{ toJson (printf "%v" .docsExamined) }},
  "reslen": {{ toJson (printf "%v" .reslen) }},
  "attr": {{ toJson (fromJson .attr) }}
}`
  }

  stage.template {
    source = "vl_line"

    template = `{"_msg":{{ toJson .display_msg }},"ns":{{ toJson .ns }},"durationMillis":{{ toJson (printf "%v" .durationMillis) }},"planSummary":{{ toJson .planSummary }},"docsExamined":{{ toJson (printf "%v" .docsExamined) }},"reslen":{{ toJson (printf "%v" .reslen) }},"attr":{{ toJson (fromJson .attr) }}}`
  }

  stage.output {
    source = "vl_line"
  }

  forward_to = [loki.write.victorialogs.receiver]
}

loki.write "victorialogs" {
  endpoint {
    url = sys.env("VICTORIALOGS_PUSH_URL")

    basic_auth {
      username = sys.env("MONITOR_AUTH_USERNAME")
      password = sys.env("MONITOR_AUTH_PASSWORD")
    }
  }
}

# Required: VictoriaLogs connection parameters.
# Change these values for the target deployment.
VICTORIALOGS_IP="172.17.30.241"
VICTORIALOGS_PORT="9428"
VICTORIALOGS_USERNAME="myuser"
VICTORIALOGS_PASSWORD="mypassword"

# Required: MongoDB log path inside the Alloy container.
MONGODB_LOG_PATH="/data/logs/mongodb/mongodb.log"

# Optional identity settings. Leave identity fields empty to use host machine-id.
# Set the MongoDB server IP when the documented mongodb-<ip> name is required.
MONGODB_SERVER_IP=""
# Optional stable identifier when the server IP is unavailable.
MONGODB_INSTANCE_ID=""
MONGODB_JOB_NAME=""
MONGODB_HOSTNAME=""
